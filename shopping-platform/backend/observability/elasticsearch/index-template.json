{
  "index_patterns": [
    "shopping-platform-logs-*"
  ],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "service": {
          "type": "keyword"
        },
        "environment": {
          "type": "keyword"
        },
        "level": {
          "type": "keyword"
        },
        "logger": {
          "type": "keyword",
          "ignore_above": 512
        },
        "thread": {
          "type": "keyword",
          "ignore_above": 256
        },
        "message": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 2048
            }
          }
        },
        "traceId": {
          "type": "keyword"
        },
        "requestId": {
          "type": "keyword"
        },
        "userId": {
          "type": "keyword"
        },
        "userType": {
          "type": "keyword"
        },
        "username": {
          "type": "keyword"
        },
        "method": {
          "type": "keyword"
        },
        "uri": {
          "type": "keyword",
          "ignore_above": 2048
        },
        "clientIp": {
          "type": "keyword"
        },
        "status": {
          "type": "integer"
        },
        "durationMs": {
          "type": "long"
        },
        "orderNo": {
          "type": "keyword"
        },
        "paymentNo": {
          "type": "keyword"
        },
        "reason": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "closeReason": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "loginIp": {
          "type": "keyword"
        },
        "amount": {
          "type": "scaled_float",
          "scaling_factor": 100
        },
        "payableAmount": {
          "type": "scaled_float",
          "scaling_factor": 100
        },
        "totalQuantity": {
          "type": "integer"
        },
        "event": {
          "properties": {
            "module": {
              "type": "keyword"
            },
            "dataset": {
              "type": "keyword"
            },
            "outcome": {
              "type": "keyword"
            }
          }
        },
        "error": {
          "properties": {
            "stack_trace": {
              "type": "wildcard"
            }
          }
        },
        "collector": {
          "type": "keyword"
        },
        "system": {
          "type": "keyword"
        },
        "log_type": {
          "type": "keyword"
        },
        "ingest_pipeline": {
          "type": "keyword"
        },
        "host": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
